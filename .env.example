# =============================================================================
# Themenbaum Generator – Konfiguration
# =============================================================================
# Kopiere diese Datei als .env und trage deine Werte ein.
# Die .env-Datei wird nicht ins Repository eingecheckt (siehe .gitignore).
# =============================================================================

# B-API Basis-URL (optional)
# Standard: AcademicCloud-Endpunkt via B-API
B_API_BASE_URL=https://b-api.staging.openeduhub.net/api/v1/llm/router/

# LLM-Modell (optional)
LLM_MODEL=topic-tree-generator

# Anzahl zusätzlicher Wiederholungsversuche für fehlgeschlagene LLM-Anfragen (optional, Standard: 4)
MAX_RETRIES=4

# Log-Level (optional, Standard: INFO)
# Werte: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Vocabulary-URLs (optional, nur bei Bedarf überschreiben)
# SKOS-Vokabulare für Bildungsstufen und Fachbereiche (edu-sharing)
EDU_CONTEXT_VOCAB_URL=https://vocabs.openeduhub.de/w3id.org/openeduhub/vocabs/educationalContext/index.json
DISCIPLINE_VOCAB_URL=https://vocabs.openeduhub.de/w3id.org/openeduhub/vocabs/discipline/index.json
