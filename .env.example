# =============================================================================
# Themenbaum-Dienst (topic-tree) – Konfiguration
# Kopieren nach .env und anpassen. .env wird nicht eingecheckt. Alle Werte haben Vorgaben.
# =============================================================================

# --- Dienst ------------------------------------------------------------------
SERVICE_ID=topic-tree
# auto: Delegations-Token (Bearer bdt_…) → b-api, sonst eigenständig | bapi | standalone
SERVICE_MODE=auto
# Optionale Dienst-Schlüssel für den eigenständigen Betrieb (kommagetrennt). Leer = offen.
# Spätestens zusammen mit OPENAI_API_KEY setzen, wenn der Dienst über HOST_PORT öffentlich erreichbar ist.
# Im Modus auto gilt ein Bearer bdt_… als b-api-Aufruf und wird nicht gegen diese Schlüssel geprüft (die b-api prüft
# es beim ersten LLM-Aufruf). Öffentliche Instanz nur mit Dienst-Schlüsseln: SERVICE_MODE=standalone.
SERVICE_API_KEYS=

# --- Container / Reverse-Proxy (docker-compose.yml hinter Traefik) -----------
# Reiner Hostname ohne https:// oder Pfad. Leer = ohne Domain, Dienst direkt unter http://<Server-IP>:18000/
# erreichbar. Kann später gesetzt werden (HTTPS über Traefik); dann HOST_BIND=127.0.0.1 setzen.
DOMAIN=
# Direktzugriff ohne Domain (docker-compose.yml): Host-Port und Schnittstelle
# HOST_PORT=18000
# HOST_BIND=0.0.0.0
# Fertiges Image aus einer Registry (Standard: öffentliches GHCR-Image dieses Repos)
# IMAGE=ghcr.io/janschachtschabel/topic-tree-generator-11-2026:latest
# Docker-Netz und Traefik-Namen (werden bei Bedarf automatisch angelegt / genutzt)
# TRAEFIK_NETWORK=topic-tree-web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# Router-/Dienstname in Traefik (global!): für eine zweite Instanz auf demselben Host eindeutig setzen,
# z. B. topic-tree-staging – sonst verteilt Traefik Anfragen auf beide Container.
# TRAEFIK_ROUTER=topic-tree

# --- b-api (LLM über den Router) ------------------------------------------------
B_API_BASE_URL=https://b-api.staging.openeduhub.net
# Option 1 – Route am b-api-Router, z. B. topic-tree-generator (LLM_MODEL wird als Altname weiter gelesen).
# Ist eine Route eingetragen, wird sie immer zuerst genutzt.
B_API_ROUTE=
# Option 2 – ein einzelnes Modell (z. B. gpt-6-luna) direkt beim Anbieter der b-api (/api/v1/llm/<Anbieter>/);
# gilt nur, wenn B_API_ROUTE leer ist. Anbieter: openai (Standard) oder academiccloud.
# (Alternativ als Route über den Router: B_API_ROUTE=openai/gpt-6-luna; Alias B_API_PROVIDER wird ebenfalls gelesen)
B_API_MODEL=
B_API_MODEL_PROVIDER=openai
# Nur wenn der b-api-Admin einen eigenen Header für das Delegations-Token gesetzt hat
B_API_DELEGATION_HEADER=
# Nur lokal: eigener Dev-Schlüssel direkt an der b-api (Leitfaden, Testen Stufe 2)
B_API_DEV_KEY=

# --- Eigenständig: OpenAI oder OpenAI-kompatibler Endpunkt ----------------------
# A provider reached with OPENAI_API_KEY counts as a third party: it gets no B3 or x-client-trace-id headers.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- LLM-Aufrufe ----------------------------------------------------------------
# common (max_completion_tokens + reasoning_effort) | gpt5 (max_completion_tokens, max low) | classic (max_tokens)
LLM_PARAM_FAMILY=common
# Maximaler Reasoning-Aufwand: none (Standard bei common) | minimal | low (nie höher als low)
LLM_REASONING_EFFORT=none
# json_schema | json_object | prompt
LLM_OUTPUT_MODE=json_schema
# auto (an bei OpenAI, aus bei b-api) | true | false
LLM_SEND_PROMPT_CACHE_KEY=auto
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Maximale parallele LLM-Aufrufe je Worker-Prozess (nur per Env steuerbar)
LLM_MAX_CONCURRENCY=20
# Harte Kostenkontrolle für Nutzeranfragen (können per API/UI nicht überschritten werden)
MAX_TREE_DEPTH=3
MAX_NODES_PER_LEVEL=20
# Wiederholungen der alten Endpunkte (Altname MAX_RETRIES)
LEGACY_MAX_RETRIES=4

# --- Laufzeit -------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=280
WEB_CONCURRENCY=2
# Ports im Container; Docker Compose veröffentlicht dieselben Ports auf dem Host. Für mehrere Dienste auf einem
# Host hier Ausweichports setzen (z. B. 8010/9010). Beide Ports müssen verschieden sein, im Container ≥ 1024.
PUBLIC_PORT=8000
INTERNAL_PORT=9000

# --- Verweise (items_ref, fulltext.ref) -----------------------------------------
# Erlaubte Hosts, kommagetrennt; ".example.org" erlaubt Subdomains. Leer = keine Verweise.
REF_ALLOWED_HOSTS=
REF_MAX_BYTES=10485760
REF_TIMEOUT_SECONDS=20
ITEMS_INLINE_MAX=500
# Upper bound for one request body in bytes (413 above it)
MAX_REQUEST_BYTES=33554432

# --- Logging & Test-UI ----------------------------------------------------------
LOG_LEVEL=INFO
# json (Betrieb) | text (lokal)
LOG_FORMAT=json
# Eingebaute Test-Oberfläche unter /ui/ (im Betrieb per UI_ENABLED=false abschalten)
UI_ENABLED=true
