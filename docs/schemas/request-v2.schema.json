{
  "$defs": {
    "Change": {
      "properties": {
        "op": {
          "$ref": "#/$defs/ChangeOp",
          "description": "Art der Änderung: add, remove, rename, edit, move, merge, split oder describe (neu beschreiben)"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel des betroffenen Knotens (remove, rename, edit, move, split, describe)",
          "title": "Key"
        },
        "keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel der zusammenzuführenden Knoten, mindestens zwei (merge)",
          "title": "Keys"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "add: Schlüssel oder Titel des Elternknotens; ohne Angabe Hauptebene",
          "title": "Parent"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "move: Schlüssel des neuen Elternknotens; ohne Angabe oder null Hauptebene",
          "title": "To"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Neuer Titel (add, rename, merge)",
          "title": "Title"
        },
        "properties": {
          "anyOf": [
            {
              "$ref": "#/$defs/Properties"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Zu setzende Properties (edit)"
        },
        "hint": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "split: wie der Knoten aufgeteilt werden soll; describe: Grundlage oder Wunsch für die Beschreibung",
          "title": "Hint"
        }
      },
      "required": [
        "op"
      ],
      "title": "Change",
      "type": "object"
    },
    "ChangeOp": {
      "enum": [
        "add",
        "remove",
        "rename",
        "edit",
        "move",
        "merge",
        "split",
        "describe"
      ],
      "title": "ChangeOp",
      "type": "string"
    },
    "ChildRange": {
      "properties": {
        "min": {
          "default": 3,
          "description": "Mindestzahl der Unterthemen je Knoten (nie genau eines)",
          "maximum": 20,
          "minimum": 2,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "default": 8,
          "description": "Höchstzahl der Unterthemen je Knoten; begrenzt durch MAX_NODES_PER_LEVEL",
          "maximum": 20,
          "minimum": 2,
          "title": "Max",
          "type": "integer"
        }
      },
      "title": "ChildRange",
      "type": "object"
    },
    "ContentRefIn": {
      "properties": {
        "id": {
          "description": "id des zugeordneten Inhalts",
          "pattern": "^[A-Za-z0-9._:-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "nodeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Knoten-ID im Repository, unverändert durchgereicht",
          "title": "Nodeid"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Konfidenz der Zuordnung zwischen 0 und 1",
          "title": "Confidence"
        }
      },
      "required": [
        "id"
      ],
      "title": "ContentRefIn",
      "type": "object"
    },
    "CurrentTree": {
      "properties": {
        "version": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metadata.version der früheren Antwort (ohne Angabe: v1)",
          "title": "Version"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metadata.title der früheren Antwort",
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metadata.description der früheren Antwort",
          "title": "Description"
        },
        "collection": {
          "description": "collection der früheren Antwort, gern von Hand bearbeitet",
          "items": {
            "$ref": "#/$defs/TreeNodeIn"
          },
          "title": "Collection",
          "type": "array"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationIn"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metadata.generation der früheren Antwort; liefert Vorgaben für alles, was die Anfrage weglässt"
        }
      },
      "required": [
        "collection"
      ],
      "title": "CurrentTree",
      "type": "object"
    },
    "ExtraTopic": {
      "enum": [
        "general",
        "methodology"
      ],
      "title": "ExtraTopic",
      "type": "string"
    },
    "Feedback": {
      "properties": {
        "text": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rückmeldung als Freitext; das Sprachmodell setzt sie in Änderungen um oder stellt Rückfragen",
          "title": "Text"
        },
        "changes": {
          "description": "Gezielte Änderungen; Struktur ohne Sprachmodell (außer split), neue Knoten danach beschrieben",
          "items": {
            "$ref": "#/$defs/Change"
          },
          "maxItems": 200,
          "title": "Changes",
          "type": "array"
        },
        "locked": {
          "description": "Schlüssel gesperrter Knoten; sie und ihr Ast bleiben unverändert",
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "title": "Locked",
          "type": "array"
        }
      },
      "title": "Feedback",
      "type": "object"
    },
    "FeedbackEntry": {
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version des Baums, auf die sich die Rückmeldung bezog",
          "title": "Version"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text der Rückmeldung",
          "title": "Text"
        }
      },
      "title": "FeedbackEntry",
      "type": "object"
    },
    "FolderNode": {
      "properties": {
        "title": {
          "description": "Name des Ordners",
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "items": {
          "description": "ids der Einträge aus items, die in diesem Ordner liegen",
          "items": {
            "pattern": "^[A-Za-z0-9._:-]{1,100}$",
            "type": "string"
          },
          "title": "Items",
          "type": "array"
        },
        "subcollections": {
          "description": "Unterordner",
          "items": {
            "$ref": "#/$defs/FolderNode"
          },
          "title": "Subcollections",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "FolderNode",
      "type": "object"
    },
    "Frame": {
      "properties": {
        "discipline_uri": {
          "description": "Fächer als SkoHub-URIs (Vokabular discipline); prägen Inhalt und Knoten-Metadaten",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Discipline Uri",
          "type": "array"
        },
        "educational_context_uri": {
          "description": "Bildungsstufen als SkoHub-URIs (educationalContext); bestimmen den Rahmen für die Form",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Educational Context Uri",
          "type": "array"
        },
        "intended_end_user_role_uri": {
          "description": "Zielgruppen als SkoHub-URIs (intendedEndUserRole), etwa Lehrkräfte oder Lernende",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Intended End User Role Uri",
          "type": "array"
        }
      },
      "title": "Frame",
      "type": "object"
    },
    "Fulltext": {
      "properties": {
        "format": {
          "$ref": "#/$defs/FulltextFormat",
          "default": "markdown",
          "description": "Format von text bzw. des geladenen Verweises"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Volltext direkt in der Anfrage (genau eines von text und ref)",
          "title": "Text"
        },
        "ref": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTPS-Adresse des Volltexts; nur Hosts aus REF_ALLOWED_HOSTS",
          "title": "Ref"
        }
      },
      "title": "Fulltext",
      "type": "object"
    },
    "FulltextFormat": {
      "enum": [
        "markdown",
        "text"
      ],
      "title": "FulltextFormat",
      "type": "string"
    },
    "GenerationIn": {
      "description": "`metadata.generation` of an earlier answer: defaults for anything the new request leaves out.",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modus des früheren Laufs"
        },
        "use_case": {
          "anyOf": [
            {
              "$ref": "#/$defs/UseCase"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use Case des früheren Laufs"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thema des früheren Laufs",
          "title": "Topic"
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/Frame"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rahmen des früheren Laufs"
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/Shape"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Form des früheren Laufs"
        },
        "hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hints"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hinweise des früheren Laufs"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/Options"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optionen des früheren Laufs (assign_only wird nie geerbt)"
        },
        "structure": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Erkannte Ordnung des früheren Laufs",
          "title": "Structure"
        },
        "feedback": {
          "description": "Bisherige Rückmeldungen",
          "items": {
            "$ref": "#/$defs/FeedbackEntry"
          },
          "title": "Feedback",
          "type": "array"
        }
      },
      "title": "GenerationIn",
      "type": "object"
    },
    "Hints": {
      "properties": {
        "context": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Freitext zu Zweck und Kontext des Baums, etwa Zielgruppe oder Einsatz",
          "title": "Context"
        },
        "include": {
          "description": "Begriffe, die im Baum vorkommen sollen",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Include",
          "type": "array"
        },
        "exclude": {
          "description": "Begriffe, die nicht vorkommen sollen",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Exclude",
          "type": "array"
        },
        "order": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gewünschtes Ordnungsprinzip, etwa „chronologisch“ oder „nach Kompetenzen“",
          "title": "Order"
        },
        "description_length": {
          "default": 60,
          "description": "Ziellänge der Beschreibungen in Wörtern",
          "maximum": 200,
          "minimum": 40,
          "title": "Description Length",
          "type": "integer"
        },
        "language": {
          "default": "de",
          "description": "Sprache der Titel und Beschreibungen als ISO-639-1-Code",
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        }
      },
      "title": "Hints",
      "type": "object"
    },
    "Item": {
      "properties": {
        "id": {
          "description": "Eindeutige id des Eintrags in dieser Anfrage; erscheint in contents und unassigned",
          "pattern": "^[A-Za-z0-9._:-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "nodeId": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Knoten-ID im Repository; wird unverändert durchgereicht, der Dienst liest den Knoten nie",
          "title": "Nodeid"
        },
        "use": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ItemUse"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rolle des Eintrags: ['structure'] Gliederung, ['content'] Inhalt, beide, oder [] keines von beiden (wird angenommen, aber weder für die Struktur genutzt noch einsortiert). Fehlt use, gilt der Standard des Use Case.",
          "title": "Use"
        },
        "properties": {
          "$ref": "#/$defs/Properties",
          "description": "edu-sharing-Properties wie cm:title oder cclom:general_keyword, Werte als Listen"
        },
        "fulltext": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fulltext"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Volltext des Eintrags, etwa ein Lehrplan als Markdown"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ablageort des Eintrags (z. B. Optik/Linsen); Hinweis bei der Zuordnung",
          "title": "Path"
        }
      },
      "required": [
        "id"
      ],
      "title": "Item",
      "type": "object"
    },
    "ItemUse": {
      "enum": [
        "structure",
        "content"
      ],
      "title": "ItemUse",
      "type": "string"
    },
    "MainRange": {
      "properties": {
        "min": {
          "default": 6,
          "description": "Mindestzahl der Hauptthemen (Ebene 1)",
          "maximum": 20,
          "minimum": 1,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "default": 12,
          "description": "Höchstzahl der Hauptthemen (Ebene 1); begrenzt durch MAX_NODES_PER_LEVEL",
          "maximum": 20,
          "minimum": 1,
          "title": "Max",
          "type": "integer"
        }
      },
      "title": "MainRange",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "create",
        "refine"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Options": {
      "properties": {
        "improve": {
          "default": false,
          "description": "Nur use_case folders: Umbenennen, Zusammenlegen und Umstellen der Ordner vorschlagen (auch nach einem Gliederungsdokument in items). Die Vorschläge sind im Baum umgesetzt und stehen als changes mit from service in der Antwort; ohne improve bleiben die Ordner wie gesendet.",
          "title": "Improve",
          "type": "boolean"
        },
        "assign_contents": {
          "default": true,
          "description": "Einträge mit Rolle content den Knoten zuordnen (mit Konfidenz). false: nur die Struktur erzeugen; gesendete Inhalte meldet INPUT_IGNORED.",
          "title": "Assign Contents",
          "type": "boolean"
        },
        "assign_only": {
          "default": false,
          "description": "Nur mode refine: nur neue Inhalte in den current_tree einsortieren. Struktur, Titel, properties und nodeId jedes Knotens bleiben (auch bei einem Baum aus dem Repository); feedback wird nicht umgesetzt. Gilt nur für diesen Aufruf und wird nicht geerbt.",
          "title": "Assign Only",
          "type": "boolean"
        },
        "multi_assign": {
          "default": true,
          "description": "true: Ein Inhalt darf an mehreren passenden Knoten hängen. false: nur am besten passenden Knoten.",
          "title": "Multi Assign",
          "type": "boolean"
        },
        "min_confidence": {
          "default": 0.6,
          "description": "Mindestkonfidenz (0 bis 1) einer Zuordnung. Darunter kommt der Inhalt mit Grund low_confidence nach unassigned; höher heißt strenger, weniger Zuordnungen.",
          "maximum": 1,
          "minimum": 0,
          "title": "Min Confidence",
          "type": "number"
        },
        "auto_metadata": {
          "default": false,
          "description": "Fach, Bildungsstufe und Zielgruppe je Knoten bestimmen und als Vokabular-URIs setzen; sinnvoll, wenn frame leer oder mehrwertig ist (z. B. fächerübergreifend). Kostet zusätzliche Aufrufe des Sprachmodells.",
          "title": "Auto Metadata",
          "type": "boolean"
        }
      },
      "title": "Options",
      "type": "object"
    },
    "Properties": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "default": {},
      "title": "Properties",
      "type": "object"
    },
    "Shape": {
      "properties": {
        "depth": {
          "default": 3,
          "description": "Anzahl der Ebenen, höchstens MAX_TREE_DEPTH; ohne shape nach Bildungsstufe und Eingabe",
          "maximum": 4,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "main_topics": {
          "$ref": "#/$defs/MainRange",
          "description": "Spanne der Hauptthemen; eine einzelne Grenze übernimmt die andere aus dem Empfehlungsrahmen"
        },
        "children": {
          "$ref": "#/$defs/ChildRange",
          "description": "Spanne der Unterthemen je Knoten"
        },
        "extra_topics": {
          "description": "Zusätzliche Hauptthemen: general (Allgemeines) und/oder methodology (Methodik und Didaktik)",
          "items": {
            "$ref": "#/$defs/ExtraTopic"
          },
          "title": "Extra Topics",
          "type": "array"
        }
      },
      "title": "Shape",
      "type": "object"
    },
    "TreeNodeIn": {
      "description": "A node of an earlier answer (v2 or legacy format), possibly edited by hand.",
      "properties": {
        "key": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel des Knotens aus der früheren Antwort; fehlt er, vergibt der Dienst einen",
          "title": "Key"
        },
        "nodeId": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Knoten-ID der Sammlung im Repository, unverändert durchgereicht",
          "title": "Nodeid"
        },
        "title": {
          "description": "Titel des Knotens",
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "shorttitle": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Kurztitel (höchstens 20 Zeichen in der Antwort)",
          "title": "Shorttitle"
        },
        "properties": {
          "$ref": "#/$defs/Properties",
          "description": "edu-sharing-Properties des Knotens"
        },
        "origin": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Herkunft des Knotens aus der früheren Antwort",
          "title": "Origin"
        },
        "contents": {
          "description": "Bereits zugeordnete Inhalte",
          "items": {
            "$ref": "#/$defs/ContentRefIn"
          },
          "title": "Contents",
          "type": "array"
        },
        "subcollections": {
          "description": "Unterknoten",
          "items": {
            "$ref": "#/$defs/TreeNodeIn"
          },
          "title": "Subcollections",
