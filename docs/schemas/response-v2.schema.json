{
  "$defs": {
    "ChangeOp": {
      "enum": [
        "add",
        "remove",
        "rename",
        "edit",
        "move",
        "merge",
        "split"
      ],
      "title": "ChangeOp",
      "type": "string"
    },
    "ChangeRecord": {
      "properties": {
        "op": {
          "$ref": "#/$defs/ChangeOp",
          "description": "Art der Änderung"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel des betroffenen oder neuen Knotens",
          "title": "Key"
        },
        "keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel der zusammengeführten Knoten (merge)",
          "title": "Keys"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel des Elternknotens eines neuen Knotens (add)",
          "title": "Parent"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel des neuen Elternknotens (move)",
          "title": "To"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Neuer Titel",
          "title": "Title"
        },
        "from": {
          "$ref": "#/$defs/ChangeSource",
          "description": "Auslöser: feedback_text, feedback_changes oder service (Vorschlag des Dienstes)"
        }
      },
      "required": [
        "op",
        "from"
      ],
      "title": "ChangeRecord",
      "type": "object"
    },
    "ChangeSource": {
      "enum": [
        "feedback_text",
        "feedback_changes",
        "service"
      ],
      "title": "ChangeSource",
      "type": "string"
    },
    "ChildRange": {
      "properties": {
        "min": {
          "default": 3,
          "description": "Mindestzahl der Unterthemen je Knoten (nie genau eines)",
          "maximum": 20,
          "minimum": 2,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "default": 8,
          "description": "Höchstzahl der Unterthemen je Knoten; begrenzt durch MAX_NODES_PER_LEVEL",
          "maximum": 20,
          "minimum": 2,
          "title": "Max",
          "type": "integer"
        }
      },
      "title": "ChildRange",
      "type": "object"
    },
    "ContentRef": {
      "properties": {
        "id": {
          "description": "id des Inhalts aus der Anfrage",
          "title": "Id",
          "type": "string"
        },
        "nodeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Knoten-ID im Repository, unverändert aus der Anfrage",
          "title": "Nodeid"
        },
        "confidence": {
          "default": 1.0,
          "description": "Konfidenz der Zuordnung zwischen 0 und 1 (1 bei Übernahme aus folders)",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ExtraTopic": {
      "enum": [
        "general",
        "methodology"
      ],
      "title": "ExtraTopic",
      "type": "string"
    },
    "FeedbackEntry": {
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version des Baums, auf die sich die Rückmeldung bezog",
          "title": "Version"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text der Rückmeldung",
          "title": "Text"
        }
      },
      "title": "FeedbackEntry",
      "type": "object"
    },
    "Frame": {
      "properties": {
        "discipline_uri": {
          "description": "Fächer als SkoHub-URIs (Vokabular discipline); prägen Inhalt und Knoten-Metadaten",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Discipline Uri",
          "type": "array"
        },
        "educational_context_uri": {
          "description": "Bildungsstufen als SkoHub-URIs (educationalContext); bestimmen den Rahmen für die Form",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Educational Context Uri",
          "type": "array"
        },
        "intended_end_user_role_uri": {
          "description": "Zielgruppen als SkoHub-URIs (intendedEndUserRole), etwa Lehrkräfte oder Lernende",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Intended End User Role Uri",
          "type": "array"
        }
      },
      "title": "Frame",
      "type": "object"
    },
    "Generation": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/Mode",
          "description": "Modus dieses Laufs"
        },
        "use_case": {
          "$ref": "#/$defs/UseCase",
          "description": "Use Case dieses Laufs"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thema dieses Laufs",
          "title": "Topic"
        },
        "frame": {
          "$ref": "#/$defs/Frame",
          "description": "Wirksamer Rahmen"
        },
        "shape": {
          "$ref": "#/$defs/Shape",
          "description": "Wirksame Form"
        },
        "hints": {
          "$ref": "#/$defs/Hints",
          "description": "Wirksame Hinweise"
        },
        "options": {
          "$ref": "#/$defs/Options",
          "description": "Wirksame Optionen"
        },
        "inputs": {
          "$ref": "#/$defs/InputCounts",
          "description": "Anzahl der Eingaben"
        },
        "feedback": {
          "description": "Alle bisherigen Rückmeldungen",
          "items": {
            "$ref": "#/$defs/FeedbackEntry"
          },
          "title": "Feedback",
          "type": "array"
        },
        "structure": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructureInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Erkannte oder vorgegebene Ordnung"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbrauch dieses Laufs"
        },
        "generator_version": {
          "description": "Version des Dienstes",
          "title": "Generator Version",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name der Route bzw. des Modells, die angefragt wurden",
          "title": "Model"
        }
      },
      "required": [
        "mode",
        "use_case",
        "frame",
        "shape",
        "hints",
        "options",
        "generator_version"
      ],
      "title": "Generation",
      "type": "object"
    },
    "Hints": {
      "properties": {
        "context": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Freitext zu Zweck und Kontext des Baums, etwa Zielgruppe oder Einsatz",
          "title": "Context"
        },
        "include": {
          "description": "Begriffe, die im Baum vorkommen sollen",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Include",
          "type": "array"
        },
        "exclude": {
          "description": "Begriffe, die nicht vorkommen sollen",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Exclude",
          "type": "array"
        },
        "order": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gewünschtes Ordnungsprinzip, etwa „chronologisch“ oder „nach Kompetenzen“",
          "title": "Order"
        },
        "description_length": {
          "default": 60,
          "description": "Ziellänge der Beschreibungen in Wörtern",
          "maximum": 200,
          "minimum": 40,
          "title": "Description Length",
          "type": "integer"
        },
        "language": {
          "default": "de",
          "description": "Sprache der Titel und Beschreibungen als ISO-639-1-Code",
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        }
      },
      "title": "Hints",
      "type": "object"
    },
    "InputCounts": {
      "properties": {
        "folders": {
          "default": 0,
          "description": "Anzahl der übergebenen Ordner",
          "title": "Folders",
          "type": "integer"
        },
        "items": {
          "$ref": "#/$defs/ItemCounts",
          "description": "Anzahl der Einträge je Rolle"
        }
      },
      "title": "InputCounts",
      "type": "object"
    },
    "ItemCounts": {
      "properties": {
        "structure": {
          "default": 0,
          "description": "Anzahl der Einträge mit Rolle structure",
          "title": "Structure",
          "type": "integer"
        },
        "content": {
          "default": 0,
          "description": "Anzahl der Einträge mit Rolle content",
          "title": "Content",
          "type": "integer"
        }
      },
      "title": "ItemCounts",
      "type": "object"
    },
    "MainRange": {
      "properties": {
        "min": {
          "default": 6,
          "description": "Mindestzahl der Hauptthemen (Ebene 1)",
          "maximum": 20,
          "minimum": 1,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "default": 12,
          "description": "Höchstzahl der Hauptthemen (Ebene 1); begrenzt durch MAX_NODES_PER_LEVEL",
          "maximum": 20,
          "minimum": 1,
          "title": "Max",
          "type": "integer"
        }
      },
      "title": "MainRange",
      "type": "object"
    },
    "Metadata": {
      "properties": {
        "title": {
          "description": "Titel des Baums",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Beschreibung des Baums",
          "title": "Description",
          "type": "string"
        },
        "target_audience": {
          "default": "Lehrkräfte",
          "description": "Zielgruppe in Worten",
          "title": "Target Audience",
          "type": "string"
        },
        "created_at": {
          "description": "Zeitpunkt der Erzeugung (ISO 8601)",
          "title": "Created At",
          "type": "string"
        },
        "author": {
          "default": "Themenbaum Generator",
          "description": "Erzeuger",
          "title": "Author",
          "type": "string"
        },
        "schema_version": {
          "default": "2.0",
          "description": "Version dieses Antwortformats",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "description": "Version des Baums (v1, v2, …); steigt mit jedem refine",
          "title": "Version",
          "type": "string"
        },
        "based_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version, auf der dieser Baum aufbaut",
          "title": "Based On"
        },
        "vocab_labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Deutsche Bezeichnungen der verwendeten Vokabular-URIs",
          "title": "Vocab Labels",
          "type": "object"
        },
        "generation": {
          "$ref": "#/$defs/Generation",
          "description": "Wirksame Vorgaben dieses Laufs; für den nächsten refine als current_tree.generation zurückgeben"
        }
      },
      "required": [
        "title",
        "created_at",
        "version",
        "generation"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "create",
        "refine"
      ],
      "title": "Mode",
      "type": "string"
    },
    "NodeOut": {
      "properties": {
        "key": {
          "description": "Stabiler Schlüssel des Knotens; bleibt über refine-Läufe erhalten",
          "title": "Key",
          "type": "string"
        },
        "nodeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Knoten-ID der Sammlung im Repository, unverändert aus current_tree",
          "title": "Nodeid"
        },
        "title": {
          "description": "Titel des Knotens",
          "title": "Title",
          "type": "string"
        },
        "shorttitle": {
          "description": "Kurztitel, höchstens 20 Zeichen",
          "title": "Shorttitle",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/NodeStatus",
          "description": "Änderungsstand gegenüber current_tree: new, unchanged, changed, moved oder suggested"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Herkunft des Knotens"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Konfidenz, falls der Knoten nur vorgeschlagen ist",
          "title": "Confidence"
        },
        "properties": {
          "$ref": "#/$defs/Properties",
          "description": "edu-sharing-Properties des Knotens, etwa cm:title, cclom:general_description, ccm:taxonid"
        },
        "contents": {
          "description": "Zugeordnete Inhalte",
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "title": "Contents",
          "type": "array"
        },
        "subcollections": {
          "description": "Unterknoten",
          "items": {
            "$ref": "#/$defs/NodeOut"
          },
          "title": "Subcollections",
          "type": "array"
        }
      },
      "required": [
        "key",
        "title",
        "shorttitle",
        "status"
      ],
      "title": "NodeOut",
      "type": "object"
    },
    "NodeStatus": {
      "enum": [
        "new",
        "unchanged",
        "changed",
        "moved",
        "suggested"
      ],
      "title": "NodeStatus",
      "type": "string"
    },
    "Options": {
      "properties": {
        "improve": {
          "default": false,
          "description": "folders: Verbesserungen der Ordnerstruktur vorschlagen; sie kommen als changes zurück",
          "title": "Improve",
          "type": "boolean"
        },
        "assign_contents": {
          "default": true,
          "description": "Inhalte aus items den Knoten zuordnen",
          "title": "Assign Contents",
          "type": "boolean"
        },
        "assign_only": {
          "default": false,
          "description": "refine: nur neue Inhalte einsortieren, Struktur bleibt; gilt nur für diesen Aufruf",
          "title": "Assign Only",
          "type": "boolean"
        },
        "multi_assign": {
          "default": true,
          "description": "Ein Inhalt darf mehreren Knoten zugeordnet werden",
          "title": "Multi Assign",
          "type": "boolean"
        },
        "min_confidence": {
          "default": 0.6,
          "description": "Mindestkonfidenz einer Zuordnung; darunter landet der Inhalt mit low_confidence in unassigned",
          "maximum": 1,
          "minimum": 0,
          "title": "Min Confidence",
          "type": "number"
        },
        "auto_metadata": {
          "default": false,
          "description": "Fach, Bildungsstufe und Zielgruppe je Knoten verengen, wenn frame leer oder mehrwertig ist",
          "title": "Auto Metadata",
          "type": "boolean"
        }
      },
      "title": "Options",
      "type": "object"
    },
    "Origin": {
      "properties": {
        "type": {
          "$ref": "#/$defs/OriginType",
          "description": "Woher der Knoten stammt: topic, document, folder, cluster oder feedback"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "id des Eintrags in items, aus dem der Knoten stammt (document)",
          "title": "Id"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Abschnitt im Dokument (document)",
          "title": "Section"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seite im Dokument, falls Seitenmarken vorhanden sind (document)",
          "title": "Page"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ordnerpfad (folders)",
          "title": "Path"
        }
      },
      "required": [
        "type"
      ],
      "title": "Origin",
      "type": "object"
    },
    "OriginType": {
      "enum": [
        "topic",
        "document",
        "folder",
        "cluster",
        "feedback"
      ],
      "title": "OriginType",
      "type": "string"
    },
    "Properties": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "Question": {
      "properties": {
        "text": {
          "description": "Rückfrage zu einer unklaren Rückmeldung",
          "title": "Text",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel des betroffenen Knotens",
          "title": "Key"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Antwortmöglichkeiten",
          "title": "Options"
        }
      },
      "required": [
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "ServiceWarning": {
      "properties": {
        "code": {
          "description": "Fester Code, etwa LLM_DEGRADED, DESCRIBE_FAILED oder SHAPE_SINGLE_CHILD",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "description": "Erklärung für Menschen",
          "title": "Message",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schlüssel des betroffenen Knotens",
          "title": "Key"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verarbeitungsschritt, in dem die Warnung entstand",
          "title": "Step"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ServiceWarning",
      "type": "object"
    },
    "Shape": {
      "properties": {
        "depth": {
          "default": 3,
          "description": "Anzahl der Ebenen, höchstens MAX_TREE_DEPTH; ohne shape nach Bildungsstufe und Eingabe",
          "maximum": 4,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "main_topics": {
          "$ref": "#/$defs/MainRange",
          "description": "Spanne der Hauptthemen; eine einzelne Grenze übernimmt die andere aus dem Empfehlungsrahmen"
        },
        "children": {
          "$ref": "#/$defs/ChildRange",
          "description": "Spanne der Unterthemen je Knoten"
        },
        "extra_topics": {
          "description": "Zusätzliche Hauptthemen: general (Allgemeines) und/oder methodology (Methodik und Didaktik)",
          "items": {
            "$ref": "#/$defs/ExtraTopic"
          },
          "title": "Extra Topics",
          "type": "array"
        }
      },
      "title": "Shape",
      "type": "object"
    },
    "StructureInfo": {
      "properties": {
        "order": {
          "description": "Ordnungsprinzip des Baums",
          "title": "Order",
          "type": "string"
        },
        "levels": {
          "description": "Bedeutung der Ebenen, von oben nach unten",
          "items": {
            "type": "string"
          },
          "title": "Levels",
          "type": "array"
        },
        "source": {
          "description": "Herkunft der Ordnung: hint (aus hints.order), detected (erkannt) oder input (aus der Eingabe)",
          "enum": [
            "hint",
            "detected",
            "input"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "order",
        "source"
      ],
      "title": "StructureInfo",
      "type": "object"
    },
    "Unassigned": {
      "properties": {
        "id": {
          "description": "id des nicht zugeordneten Inhalts",
          "title": "Id",
          "type": "string"
        },
        "nodeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Knoten-ID im Repository, unverändert aus der Anfrage",
          "title": "Nodeid"
        },
