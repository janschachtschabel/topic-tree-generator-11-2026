const { chromium } = require('playwright');
const BASE = 'http://127.0.0.1:18700';
let fails = 0;
const check = (name, ok, extra = '') => { console.log(`${ok ? 'PASS' : 'FAIL'} ${name} ${extra}`); if (!ok) fails++; };
const focusInfo = (page) => page.evaluate(() => { const a = document.activeElement; return { tag: a.tagName, id: a.id, cls: a.className, row: a.closest('.change-row') ? [...document.querySelectorAll('#changes-editor .change-row')].indexOf(a.closest('.change-row')) : -1 }; });
(async () => {
  const b = await chromium.launch(); const page = await b.newPage();
  page.on('pageerror', (e) => { console.log('PAGEERR', e.message); fails++; });
  await page.goto(BASE + '/ui/'); await page.waitForTimeout(600);
  const task = (t) => page.click(`.task-btn[data-task="${t}"]`);
  const preset = async (id) => { await page.selectOption('#f-preset', id); await page.waitForTimeout(100); };

  // 1. language switch keeps base display
  await task('refine'); await preset('refine_changes');
  await page.click('#lang-en'); await page.waitForTimeout(100);
  const summ = await page.textContent('#base-summary');
  check('1 refine summary in EN keeps base', /nodes/.test(summ) && !/No base/.test(summ), summ);
  check('1 base heading EN', /^Base:/.test(await page.textContent('#base-heading')), await page.textContent('#base-heading'));
  check('1 base buttons EN', (await page.locator('#base-tree .lock-btn').first().textContent()) === 'Lock');
  await task('assign'); await preset('assign_foreign');
  await page.click('#lang-de'); await page.waitForTimeout(100);
  check('1 assign label stays assign in DE', /bleibt unverändert/.test(await page.textContent('#base-tree-label')), await page.textContent('#base-tree-label'));

  // 7. view toggles visible with base
  check('7 view toggles visible for base', await page.isVisible('#view-toggles'));

  // 4. JSON preset shows its base
  await page.goto(BASE + '/ui/'); await page.waitForTimeout(600);
  await task('assign'); await preset('assign_only');
  const s4 = await page.textContent('#base-summary');
  check('4 JSON preset shows base summary', !/Noch keine Basis/.test(s4), s4);
  check('4 JSON preset base area visible', await page.isVisible('#base-area'));
  await preset('assign_foreign'); await preset('assign_only');
  const h4 = await page.textContent('#base-heading');
  check('4 base heading follows JSON preset', !/Physik Klasse 7\/8/.test(h4), h4);

  // 2. keyless base in refine shows hint
  await task('refine');
  await page.evaluate(() => { document.querySelector('#lbl-current-tree').click(); });
  const foreign = (await (await page.request.get(BASE + '/ui/presets')).json()).presets.find((p) => p.id === 'assign_foreign').payload.current_tree;
  await page.fill('#f-current-tree', JSON.stringify(foreign)); await page.dispatchEvent('#f-current-tree', 'change');
  await page.waitForTimeout(100);
  check('2 keyless hint shown', await page.isVisible('#keyless-hint'), await page.locator('#keyless-hint').textContent().catch(() => ''));
  await preset('refine_changes');
  check('2 keyless hint hidden for keyed base', !(await page.isVisible('#keyless-hint')));

  // 6. accessible names
  const lockName = await page.locator('#base-tree .lock-btn').first().getAttribute('aria-label');
  check('6 lock button has node name', /„.+“ sperren/.test(lockName || ''), lockName);
  const editName = await page.locator('#base-tree .edit-btn').first().getAttribute('aria-label');
  check('6 edit button has node name', /„.+“ ändern/.test(editName || ''), editName);
  const treeName = await page.evaluate(() => { const el = document.getElementById('base-tree'); const id = el.getAttribute('aria-labelledby'); return el.getAttribute('aria-label') || (id && document.getElementById(id).textContent); });
  check('6 base tree has name', Boolean(treeName), treeName);
  await page.click('#lang-en'); await page.waitForTimeout(50);
  const lockEn = await page.locator('#base-tree .lock-btn').first().getAttribute('aria-label');
  check('6 lock name in EN', /^Lock “.+”$/.test(lockEn || ''), lockEn);
  await page.click('#lang-de'); await page.waitForTimeout(50);

  // 3. keyboard focus in change editor
  const op0 = page.locator('#changes-editor .change-row').nth(1).locator('select.change-op');
  await op0.focus(); await page.keyboard.press('ArrowDown'); await page.waitForTimeout(50);
  let f = await focusInfo(page);
  check('3 focus stays on op select after change', f.tag === 'SELECT' && f.cls.includes('change-op') && f.row === 1, JSON.stringify(f));
  const nRows = await page.locator('#changes-editor .change-row').count();
  await page.locator('#changes-editor .change-row').nth(1).locator('.change-remove').focus();
  await page.keyboard.press('Enter'); await page.waitForTimeout(50);
  f = await focusInfo(page);
  check('3 focus after remove goes to next row', f.row === 1 && f.tag !== 'BODY', JSON.stringify(f));
  // remove last row -> next row is gone; focus to previous row or add button
  await page.locator('#changes-editor .change-row').last().locator('.change-remove').focus();
  await page.keyboard.press('Enter'); await page.waitForTimeout(50);
  f = await focusInfo(page);
  check('3 focus after removing last row not on body', f.tag !== 'BODY', JSON.stringify(f));

  // 5. focus after "Ändern ..." on base and after "Sperren"
  const before = await page.locator('#changes-editor .change-row').count();
  await page.locator('#base-tree .edit-btn').first().click(); await page.waitForTimeout(100);
  f = await focusInfo(page);
  check('5 focus on new change row after edit', f.row === before, JSON.stringify(f));
  await page.locator('#base-tree .lock-btn').nth(1).click(); await page.waitForTimeout(100);
  f = await focusInfo(page);
  check('5 focus on lock button after lock (base re-render)', f.cls.includes('lock-btn') && !f.cls.includes('edit-btn'), JSON.stringify(f));

  // 5. focus result heading after submit
  await task('topic'); await preset('topic_sek1');
  await page.click('#btn-submit'); await page.waitForSelector('#result-area:not([hidden])', { timeout: 30000 });
  await page.waitForTimeout(100);
  f = await focusInfo(page);
  check('5 focus result heading after submit', f.id === 'result-heading', JSON.stringify(f));
  // lock on result -> base, focus in base tree
  await page.locator('#tree-container .lock-btn').first().click(); await page.waitForTimeout(100);
  f = await focusInfo(page);
  const inBase = await page.evaluate(() => document.getElementById('base-tree').contains(document.activeElement));
  check('5 focus in base tree after lock on result', inBase, JSON.stringify(f));

  // 8. adopt in assign stays in assign
  await task('assign'); await preset('assign_foreign');
  await page.click('#btn-submit'); await page.waitForSelector('#result-area:not([hidden])', { timeout: 30000 });
  await page.click('#btn-adopt'); await page.waitForTimeout(100);
  check('8 adopt stays in assign', (await page.evaluate(() => window.TopicTreeApp.state.task)) === 'assign');
  check('8 adopted base is shown', await page.isVisible('#base-area'));

  // 9. texts
  const combos = await page.evaluate(() => { const app = window.TopicTreeApp; app.selectTask('topic'); return [...document.querySelectorAll('#f-preset optgroup option')].map((o) => o.textContent); });
  check('9 no Kombination prefix in grouped options', combos.length > 0 && combos.every((c) => !/^Kombination:/.test(c)), JSON.stringify(combos.slice(-2)));
  await task('refine');
  const ao = await page.textContent('label:has(#f-opt-assign-only) span');
  check('9 assign-only text uses Inhalte', /Nur Inhalte einsortieren/.test(ao), ao);
  await page.click('#lang-en'); await page.click('#lang-de');
  const ao2 = await page.textContent('label:has(#f-opt-assign-only) span');
  check('9 assign-only text after lang round trip', /Nur Inhalte einsortieren/.test(ao2), ao2);

  console.log(fails ? `${fails} FAILED` : 'ALL PASS');
  await b.close();
})();
